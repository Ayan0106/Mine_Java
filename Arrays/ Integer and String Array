public class Array{
    public static void main(String[] args){
        
        int[] arr1={1,2,3,4,5};              // Integer Array
        String[] arr2={"Ayan","Banerjee","Learner","Student"}; // String Array
        
        System.out.println(arr1[0]);
        System.out.println(arr1.length);  // Length of Integer Array
        
        System.out.println(arr2[0]);
        System.out.println(arr2.length);  // Length of String Array
    }
}

// Output ...
// 1
// 5
// Ayan
// 4
