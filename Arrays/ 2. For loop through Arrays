public class Array{
    public static void main(String[] args){
        
        int[] arr1={1,2,3,4,5};              
        for(int i:arr1){             // "for-each" loop is used exclusively to loop through elements in arrays.
            System.out.println(i);
        }
    }
}

// Output ...
// 1
// 2
// 3
// 4
// 5
