import java.util.*;
class Main{
    public static void main(String[]args){
        Scanner obj=new Scanner (System.in);
        // Decimal → Binary
        int n=obj.nextInt();
        System.out.println(Integer.toBinaryString(n));
        // Binary → Decimal
        String n=obj.nextLine();
        System.out.println(Integer.parseInt(n,2));
    }
}
