import java.util.*;
public class Count_digits{
    public static void main(String[]args){
        Scanner obj=new Scanner (System.in);
        int n=obj.nextInt();

        int count=0;
        while (n!=0){     // if n>0 , then it returns 0 for -ve numbers.
        // We don't know how many iterations are needed...the digits of the n is not known 
            n/=10;
            count++;
        }
        System.out.println(count);
    }
}
