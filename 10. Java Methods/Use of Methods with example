import java.util.*;
class Main {
    public static int ayan(int n, int r){
        int fact1=1;
        int fact2=1;
        int fact3=1;
        for(int i=n;i>=1;i--){
            fact1*=i;
        }
        for(int i=r;i>=1;i--){
            fact2*=i;
        }
        for(int i=n-r;i>=1;i--){
            fact3*=i;
        }
        int result=fact1/(fact2*fact3);
        return result;
        // return sum;
        // System.out.println(sum);
    }
    public static void main(String[] args) {
        Scanner sc= new Scanner(System.in);
        System.out.println("Enter any number");
        int n=sc.nextInt();
        int r=sc.nextInt();
        System.out.println(ayan(n,r));
        // ayan(a,b);
        
    }
}




// 👇 Use of method , argument pass and reduce the repitation of loops..👇


import java.util.*;
class Main {
    public static int fact(int x){
        int f=1;
        for(int i=x;i>=1;i--){
            f*=i;
        }
        return f;
    }
    public static void main(String[] args) {
        Scanner sc= new Scanner(System.in);
        System.out.println("Enter any number");
        int n=sc.nextInt();
        int r=sc.nextInt();
        
        int ncr=fact(n)/(fact(r)*fact(n-r));
        int npr=fact(n)/fact(n-r);
        System.out.println(ncr);
        System.out.println(npr);
        // ayan(a,b);
        
    }
}








