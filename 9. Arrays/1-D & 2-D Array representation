class Learning{
    void one_Dim_array(){
        int[] a= new int [3]; // size define (size 3 means 0,1,2)
        a[0]=23;
        a[1]=34;
        a[2]=12;
        System.out.println(a[0]);
        System.out.println(a[1]);
        System.out.println(a[2]);
    //  System.out.println(a[3]); // Exception in thread "main" java.lang.ArrayIndexOutOfBoundsException: Index 3 out of bounds for length 3
    }
    
    void two_Dim_array(){
        int[][] b= new int [2][2];  // 2 means row-size and 2 means column-size
        b[0][0]=23;
        b[0][1]=34;
        b[1][0]=23;
        b[1][1]=34;

        // int[][] b;               // ARRAY can also be initialised by this structure.
        // b= new int{{12,23},{34,45}};
        
        System.out.println(b[0][0]);
        System.out.println(b[0][1]);
        System.out.println(b[1][0]);
        System.out.println(b[1][1]);
    
    }
}

public class Array {
    public static void main(String[] args) {
        Learning obj= new Learning();
        obj.one_Dim_array();
        obj.two_Dim_array();
    }
}



